{
  "name": "wuhu-admin-vue",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "pnpm routes:check && vue-tsc -b && vite build",
    "build:test": "pnpm routes:check && vue-tsc -b && vite build --mode test",
    "analyze": "cross-env VITE_ANALYZE=true VITE_ANALYZE_RAW=true VITE_ROUTE_COMPONENT_STRICT=false vite build",
    "bundle:check": "node scripts/check-bundle.mjs",
    "build:analyze": "pnpm analyze && pnpm bundle:check",
    "check": "pnpm routes:check && pnpm test:unit && pnpm typecheck && pnpm lint && pnpm e2e",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "commit": "git-cz",
    "lint:lint-staged": "lint-staged",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:style": "stylelint \"src/**/*.{css,less,vue}\" --allow-empty-input",
    "lint:style:fix": "stylelint \"src/**/*.{css,less,vue}\" --fix --allow-empty-input",
    "lint:stylelint": "pnpm lint:style:fix",
    "routes:check": "node scripts/check-routes.mjs",
    "test": "pnpm test:unit",
    "test:unit": "node --test tests/**/*.test.ts",
    "e2e": "playwright test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky",
    "preview": "vite preview",
    "release": "standard-version",
    "typecheck": "vue-tsc -b --pretty false",
    "typecheck:node": "tsc -p tsconfig.node.json --pretty false"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@dayflow/core": "3.7.0",
    "@dayflow/plugin-drag": "^1.6.0",
    "@dayflow/vue": "^3.7.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/vue": "^0.5.0",
    "@tanstack/vue-virtual": "^3.13.35",
    "@tiptap/core": "3.30.1",
    "@tiptap/extension-character-count": "3.30.1",
    "@tiptap/extension-color": "3.30.1",
    "@tiptap/extension-font-family": "3.30.1",
    "@tiptap/extension-highlight": "^3.30.1",
    "@tiptap/extension-image": "3.30.1",
    "@tiptap/extension-placeholder": "^3.30.1",
    "@tiptap/extension-subscript": "3.30.1",
    "@tiptap/extension-superscript": "3.30.1",
    "@tiptap/extension-table": "3.30.1",
    "@tiptap/extension-table-cell": "3.30.1",
    "@tiptap/extension-table-header": "3.30.1",
    "@tiptap/extension-table-row": "3.30.1",
    "@tiptap/extension-task-item": "3.30.1",
    "@tiptap/extension-task-list": "3.30.1",
    "@tiptap/extension-text-align": "^3.30.1",
    "@tiptap/extension-text-style": "3.30.1",
    "@tiptap/extension-typography": "^3.30.1",
    "@tiptap/extension-underline": "^3.30.1",
    "@tiptap/pm": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "@tiptap/vue-3": "^3.30.1",
    "@viselect/vue": "^3.9.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vue/devtools-api": "8.2.1",
    "@vueuse/core": "^14.4.0",
    "@zhouchengfeng/okay": "^1.0.0",
    "antdv-next": "^1.5.1",
    "codemirror": "^6.0.2",
    "cropperjs": "^2.1.1",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.13",
    "echarts": "^6.1.0",
    "enum-plus": "^3.3.0",
    "es-toolkit": "^1.51.0",
    "frappe-gantt": "^1.2.2",
    "jit-viewer": "^1.5.0",
    "ky": "^2.0.2",
    "mitt": "^3.0.1",
    "motion-v": "^2.4.0",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-vue": "^0.5.10",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pinyin-match": "^1.2.10",
    "swapy": "^1.0.5",
    "topbar": "^3.0.1",
    "vue": "3.6.0-rc.2",
    "vue-echarts": "^8.1.0",
    "vue-i18n": "^11.4.8",
    "vue-request": "^2.0.4",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@antdv-next/auto-import-resolver": "^1.1.1",
    "@antdv-next/unocss": "^1.1.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@faker-js/faker": "^10.6.0",
    "@iconify-json/lucide": "^1.2.123",
    "@types/node": "26.2.0",
    "@unocss/preset-wind4": "^66.7.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/tsconfig": "^0.9.1",
    "commitizen": "^4.3.2",
    "conventional-changelog": "^8.1.3",
    "cross-env": "^10.1.0",
    "cz-git": "^1.13.2",
    "husky": "^9.1.7",
    "less": "^4.9.0",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "postcss-html": "^2.0.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "standard-version": "^9.5.0",
    "stylelint": "^17.14.1",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-recommended-less": "^4.2.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.13.tsgo.7.0.2",
    "unocss": "^66.7.5",
    "unocss-preset-extra": "^1.0.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-fonts": "^2.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "8.2.1",
    "vite-auto-i18n-plugin": "^1.1.16",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-external-cdn": "^1.1.1",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-lazy-import": "^1.0.7",
    "vite-plugin-mock-dev-server": "^2.4.2",
    "vue-tsc": "^3.3.10"
  },
  "lint-staged": {
    "*.{js,ts,mjs,mts,tsx}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{cjs,json,jsonc}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.vue": [
      "oxlint --fix",
      "stylelint --fix --allow-empty-input",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.html": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{css,less}": [
      "stylelint --fix --allow-empty-input",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{md,mdx}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  }
}
