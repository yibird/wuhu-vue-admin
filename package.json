    "@vue/devtools-api": "8.2.1",
    "@vueuse/core": "^15.0.0",
    "@zhouchengfeng/okay": "^1.0.0",
    "antdv-next": "^1.6.0",
    "codemirror": "^6.0.2",
    "cropperjs": "^2.3.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
