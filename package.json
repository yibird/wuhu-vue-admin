{
  "name": "wuhu-admin-vue",
  "version": "0.0.1",
  "private": true,
  "description": "Wuhu Vue Admin 是一个基于 Vue 3、Pinia、Vue Router、UnoCSS、Vite、Antdv Next 和 TypeScript 构建的现代化企业级后台管理系统，支持开箱即用，内置仪表盘、系统管理、工作流、低代码、报表设计、IM 聊天、AI 工作流等常用解决方案，助力企业级应用快速开发",
  "homepage": "https://github.com/yibird/wuhu-admin-vue#readme",
  "bugs": {
    "url": "https://github.com/yibird/wuhu-admin-vue/issues"
  },
  "license": "MIT",
  "author": "zchengfeng <2684837849@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yibird/wuhu-admin-vue.git"
  },
  "funding": "https://github.com/sponsors/yibird",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "vue-tsc -b && vite build",
    "build:test": "vue-tsc -b && vite build --mode test",
    "analyze": "cross-env VITE_ANALYZE=true VITE_ANALYZE_RAW=true VITE_ROUTE_COMPONENT_STRICT=false vite build",
    "bundle:check": "node scripts/check-bundle.mjs",
    "build:analyze": "pnpm analyze && pnpm bundle:check",
    "check": "pnpm test:unit && pnpm typecheck && pnpm lint",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "commit": "git-cz",
    "lint:lint-staged": "lint-staged",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:style": "stylelint \"src/**/*.{css,less,vue}\" --allow-empty-input",
    "lint:style:fix": "stylelint \"src/**/*.{css,less,vue}\" --fix --allow-empty-input",
    "lint:stylelint": "pnpm lint:style:fix",
    "test": "pnpm test:unit",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky",
    "preview": "vite preview",
    "release": "standard-version",
    "typecheck": "vue-tsc -b --pretty false",
    "typecheck:node": "tsc -p tsconfig.node.json --pretty false",
    "review": "ocr review"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
