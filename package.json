    "vue": "3.6.0-rc.4",
    "vue-echarts": "^8.3.2",
    "vue-i18n": "^11.4.14",
    "vue-router": "5.4.0",
    "vue3-tree-org": "^4.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@alibaba-group/open-code-review": "^1.13.0",
    "@antdv-next/auto-import-resolver": "^1.2.0",
    "@antdv-next/unocss": "^1.1.2",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@faker-js/faker": "^10.6.0",
    "@iconify-json/lucide": "^1.2.144",
    "@types/node": "26.6.5",
    "@unocss/preset-wind4": "^66.11.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/tsconfig": "^0.9.1",
    "commitizen": "^4.3.2",
    "conventional-changelog": "^8.1.3",
    "cross-env": "^10.1.0",
    "cz-git": "^1.14.0",
    "fontless": "^1.3.2",
    "husky": "^9.1.7",
    "less": "^4.9.1",
    "lightningcss": "^1.33.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "postcss-html": "^2.0.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "standard-version": "^9.5.0",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-recommended-less": "^4.2.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.18.tsgo.7.0.2",
    "unocss": "^66.11.0",
    "unocss-preset-extra": "^1.0.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "8.3.4",
    "vite-auto-i18n-plugin": "^1.1.16",
    "vite-imagetools": "^12.0.1",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-mock-dev-server": "^2.4.2",
    "vite-plugin-pwa": "^2.0.0",
    "vue-tsc": "3.3.11"
  },
  "lint-staged": {
    "*.{js,ts,mjs,mts,tsx}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{cjs,json,jsonc}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.vue": [
      "oxlint --fix",
      "stylelint --fix --allow-empty-input",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.html": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{css,less}": [
      "stylelint --fix --allow-empty-input",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{md,mdx}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  }
}
